{
  "name": "inkstream-cli",
  "version": "1.0.0",
  "description": "CLI to sync project docs into a central Vercel-deployed docs site",
  "main": "dist/index.js",
  "bin": {
    "inkstream": "./bin/inkstream.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "docs",
    "cli",
    "sync",
    "markdown",
    "vercel"
  ],
  "author": "GreatBamba",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "enquirer": "^2.4.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.4.5"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.3",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(.*)\\.js$": "$1"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
